{
  "name": "@unbrowse/plugin-elizaos",
  "version": "2.0.5",
  "description": "ElizaOS plugin that routes web tasks through Unbrowse before Playwright browser automation.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.0.0"
  },
  "dependencies": {
    "unbrowse": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "author": "Lewis <https://github.com/lekt9>",
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "UNBROWSE_BASE_URL": {
        "type": "string",
        "description": "Optional remote Unbrowse server URL; omit to use local CLI"
      },
      "UNBROWSE_ROUTING_MODE": {
        "type": "string",
        "description": "strict or fallback"
      }
    }
  }
}

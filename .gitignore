.bench-local/
.traction-snapshots/
.harness-out/
.bench-budget*/

# Recursive mining harness raw artifacts — captured agent transcripts that
# can include arbitrary credentials (PATs, cookies, tokens). Never commit.
harness/recursive/runs/**/raw-hits.jsonl
harness/recursive/runs/**/raw-hits-*.jsonl

# aiko local state (plans, codebase index, agent notes)
.aiko/
AIKO.md
**/AIKO.md

# eval corpus snapshots (per-day local artifacts)
evals/corpus-probes-*.json
evals/corpus-run-*.json

# aiko-loop frontend parity scripts (reference local SOT path)
frontend/scripts/check-design-parity.sh
frontend/scripts/check-no-cruft.sh
frontend/scripts/check-typecheck.sh

# strategy / moat docs — local-only, never commit
docs/endpoint-as-cell.md
docs/moat/
docs/strategy/

# Python cache from extract.py invocations
scripts/__pycache__/

# Bundle-attribution viewer scratch output
packages/skill/dist-sm/

# Bench-gate per-run artifacts (per-probe captures + judge bundles + verdicts).
# `.bench-gate/stamp.json` IS committed — it's the release-it gate marker.
.bench-gate/*/
!.bench-gate/stamp.json
!.bench-gate/stamp.mcp.json

# bench-converge runtime artifacts (per-run dirs + sandboxed unbrowse state).
# Stamp output lands in .bench-gate/stamp.mcp.json (whitelisted above).
.bench-converge/
.mcp-proxy-env.json

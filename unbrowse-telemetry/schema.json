{
  "fields": ["event", "version", "os", "install_id", "tool", "outcome", "duration_ms", "error_class", "from"],
  "from": { "event": "node_start", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$", "max_chars": 40 },
  "required": ["event", "version", "os", "install_id", "outcome"],
  "events": ["node_start", "tool_call", "route_failed", "fetch_failed"],
  "tools": [
    "unbrowse_search",
    "unbrowse_do",
    "unbrowse_browse",
    "unbrowse_call",
    "/v1/routes",
    "/v1/do",
    "/v1/browse",
    "/v1/routes/{id}/call",
    "/v1/remote/call/{id}"
  ],
  "outcomes": ["ok", "failed", "error"],
  "error_classes": [
    "bad_request", "unauthorized", "payment_required", "forbidden", "not_found", "conflict", "unavailable", "internal", "site", "other",
    "step_status", "door", "not_an_answer", "needs_browser", "source_missing", "unsupported_body", "breaks_body", "missing_input", "missing_minted", "shape_mismatch", "http", "transport", "bad_url", "refused", "refused_hop", "file", "socket", "no_body"
  ],
  "oses": ["macos", "linux", "windows", "other"],
  "max_duration_ms": 86400000,
  "max_events": 100,
  "max_body_bytes": 65536,
  "reports": {
    "fields": ["kind", "summary", "expected", "got", "goal", "url", "tool", "error", "route", "last_error", "version", "os", "source", "install_id"],
    "required": ["kind", "summary", "version", "os", "source", "install_id"],
    "kinds": ["wrong_data", "false_success", "failed", "slow", "confusing", "other"],
    "sources": ["agent", "node"],
    "tools": ["unbrowse_search", "unbrowse_do", "unbrowse_browse", "unbrowse_logins", "unbrowse_call", "unbrowse_whoami"],
    "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "WS"],
    "route_fields": ["method", "host", "path", "inputs", "write", "steps"],
    "last_error_fields": ["tool", "class", "error"],
    "max_chars": { "summary": 140, "expected": 600, "got": 1500, "goal": 200, "url": 300, "error": 600, "host": 253, "path": 300, "input": 64, "last_error": 300 },
    "max_inputs": 30,
    "max_steps": 100,
    "max_body_bytes": 16384,
    "per_install_per_day": 20,
    "new_issues_per_day": 30,
    "comments_per_day": 100,

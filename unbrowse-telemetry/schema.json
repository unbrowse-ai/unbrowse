      { "in": "signed in as lewis@unbrowse.ai with vault:github.com:lewis and token ghp_abcdefghijklmnopqrstuvwxyz0123456789", "out": "signed in as [email] with [vault] and token [token]", "private": ["lewis@", "vault:", "ghp_"] },
      { "in": "called https://user:pw@api.example.com/v1/users/12345678/orders/9f8b7c6d5e4f3a2b1c0d?key=s3cret", "out": "called https://*.example.com/v1/users/{number}/orders/{hex}", "private": ["user:pw", "api.example.com", "12345678", "9f8b7c6d5e4f3a2b1c0d", "s3cret"] },
      { "in": "server 10.0.0.12:8080 said 503; wallet 0x52908400098527886E0F7030069857D2E4169EE7; order 123456789012", "out": "server [ip] said 503; wallet [hex]; order [number]" },

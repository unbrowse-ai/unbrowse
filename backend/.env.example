# Backend env vars — copy to backend/.dev.vars (Wrangler) or set in the
# Cloudflare dashboard. The repo-root .env.example covers shared CLI/dev
# vars; this file documents Worker-specific keys.

# --- v6.16 migration note (read before deploy) ---
# Cascade env vars CASCADE_PLATFORM_WALLET and CASCADE_SIGNER_SECRET_KEY
# are no longer read by the worker — Faremeter Flex carries the 10% platform
# cut natively in every signed authorization. CASCADE_RPC_URL and
# CASCADE_RPC_WS_URL are kept (still used as the Solana RPC binding for Flex);
# the rename to SOLANA_RPC_URL is deferred to v6.17 for deploy safety.
# Run `bun backend/scripts/cascade-final-distribute.ts` on prod BEFORE
# deploying v6.16 to flush any USDC sitting in Cascade split vaults.

# --- Platform Sponsor Wallet (v6.15.0+) ---
# Used to subsidise the first calls per agent so creators earn x402 USDC
# immediately. When unset in prod, the sponsor middleware refuses-to-enable
# and the standard 402 flow runs unchanged.
#
# Note (v6.16.0): _ADDRESS is the payer-of-record advertised to creators.
# _KEY is the sponsor-mode gate — must be set for sponsor mode to enable.
# Actual USDC settlement now rides on Faremeter Flex: the sponsor authorization
# is signed against the sponsor escrow with the agent's skill splits, and
# the platform recoups its 10% via the same authorization's splits array.
# (Pre-v6.16, signing ran through the Cascade signer + the Cascade splits
# vault; that path is gone.)
PLATFORM_SPONSOR_WALLET_ADDRESS=
PLATFORM_SPONSOR_WALLET_KEY=
SPONSOR_CAP_DAILY_USD=1.0
SPONSOR_GLOBAL_DAILY_USD=50.0

# --- Faremeter Flex (v6.16.0+) ---
# Self-hosted Flex facilitator key (Solana keypair as base58 secret).
# Set via: wrangler secret put FLEX_PLATFORM_FACILITATOR_KEY
FLEX_PLATFORM_FACILITATOR_KEY=
# USDC associated token account (ATA) owned by the platform wallet — destination of the 50% platform cut in every authorization (raised from 10% in the unbrowse-payments-faremeter wave).
# This is NOT the same as the base wallet pubkey. Derive once with:
#   bun backend/scripts/derive-usdc-ata.ts <base wallet pubkey>
# example: derive-usdc-ata.ts Bpr49sQXsxwNXNMRWS2v3tTBGWu2QgZtdA83BX77xBX1
# Set via: wrangler secret put FLEX_PLATFORM_RECIPIENT_USDC_ATA --env production
FLEX_PLATFORM_RECIPIENT_USDC_ATA=
# Base wallet pubkey of the platform recipient. Used by legacy splits.ts fallback path.
# Bpr49sQXsxwNXNMRWS2v3tTBGWu2QgZtdA83BX77xBX1 is the production pubkey for unbrowse.
PAYMENT_RECIPIENT=
# Refund window before pending settlements finalize. Min 150 (~1min), max 1,296,000 (~6 days).
FLEX_REFUND_TIMEOUT_SLOTS=150
# Deadman switch — client can recover funds after this many slots of facilitator silence.
FLEX_DEADMAN_TIMEOUT_SLOTS=1000

# --- PayAI (exact-scheme dual-accept rail) ---
# PayAI's facilitator handles the exact-scheme leg of the dual-accept Flex envelope.
# The KEY is sensitive (Ed25519 PKCS#8 private key); never commit, never log.
# Set via: wrangler secret put PAYAI_API_KEY --env production
PAYAI_API_KEY=
# Rotation weight: 0 = always Flex-first in 402 envelope, 10000 = always PayAI-first.
# Default 5000 = 50/50 deterministic per agent_id hash. Clients still pick which
# accept entry to pay; this only biases the order they see.
PAYAI_ROTATION_BPS=5000

# --- v6.16 sponsor-on-Flex (opt-in, preview.0) ---
# When SPONSOR_USE_FLEX_SPLIT=1, the sponsor middleware signs a Flex
# authorization against FLEX_SPONSOR_ESCROW_ADDRESS using the
# FLEX_SPONSOR_SESSION_KEY_SECRET (Ed25519, rotated). The authorization carries
# the agent's skill splits so the platform recoups its 10% in the same
# settlement. When unset/"0", sponsor mode falls back to direct-SPL transfer
# from the platform sponsor wallet (v6.15 behavior).
#
# The session key is registered to the sponsor escrow out-of-band — operators
# rotate by minting a new key, registering it on-chain, then setting
# FLEX_SPONSOR_SESSION_KEY_SECRET + _EXPIRES_AT_SLOT here together.
SPONSOR_USE_FLEX_SPLIT=0
FLEX_SPONSOR_ESCROW_ADDRESS=
FLEX_SPONSOR_SESSION_KEY_SECRET=
FLEX_SPONSOR_SESSION_KEY_EXPIRES_AT_SLOT=

# ── Fair-compensation engine (services/fair-compensation.ts) ──────────────────
# Unbrowse's take on FACILITATED TRANSACTION COSTS: when the platform fronts a
# paid upstream for an agent (x402 web-unblocker, LLM proxy, paid API,
# facilitator/gas), it recoups this share on top of the raw cost. The markup is
# the platform's compensation; the upstream cost passes through. Paid to
# PAYMENT_RECIPIENT. Basis points, 0–10000. Default 2000 (20%) when unset.
FAIR_COMPENSATION_BPS=2000

{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "unbrowse-ci-oauth-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "SESSION", "class_name": "ChatGPTSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatGPTSession"] }]
}

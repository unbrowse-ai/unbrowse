{
  "_what": "What a person does through an agent, through the node's MCP tools, in order, with no model: mcp_check.py runs each step, checks the reply against `expect` and the tool's published schema, and takes a picture of it. `expect.result`: ok (an answer), refused (isError or a protocol error), any (answered either way). `in`: a path's value is one of these; `has`: a path is not empty; `says` / `never_says`: words in the reply. `save` keeps a reply's value for `{{name}}` later. `shot`: the node's browser in a session, a url opened straight in Chrome, or (default) the reply drawn. `method` (resources/list, resources/read) sends that request instead of a tool call, its result checked the same way. `journeys` names the journeys in journeys.json the step walks (journey_coverage.py). Every tool the node lists is called by a step or waived here with a reason.",
  "steps": [
    { "id": "whoami", "tool": "unbrowse_whoami", "args": {}, "what": "the agent checks it reaches its node", "expect": {"has": ["agent", "node"]}, "journeys": ["whoami-reaches-node"] },
    { "id": "logins", "tool": "unbrowse_logins", "args": {}, "what": "the vault, as refs, never a password", "expect": {"never_says": ["SuperSecretPassword!"]}, "journeys": ["vault-sign-in-without-password"] },
    { "id": "app-list", "method": "resources/list", "params": {}, "what": "an MCP app host finds the answer view", "expect": {"says": ["ui://unbrowse/answer.html"]}, "journeys": ["mcp-app-answer-view"] },
    { "id": "app-read", "method": "resources/read", "params": {"uri": "ui://unbrowse/answer.html"}, "what": "and reads it as an MCP app page", "expect": {"has": ["contents.0.text"], "says": ["text/html"]}, "journeys": ["mcp-app-answer-view"] },
    { "id": "do-data-url", "tool": "unbrowse_do", "args": {"goal": "read the robots file", "url": "https://www.python.org/robots.txt"}, "what": "a url that is data is its own route", "expect": {"in": {"how": ["learned", "called"]}, "has": ["result.data"]}, "shot": {"url": "https://www.python.org/robots.txt"}, "journeys": ["data-url-and-site-refusal"] },
    { "id": "do-learns", "tool": "unbrowse_do", "args": {"goal": "quotes", "url": "https://quotes.toscrape.com/"}, "what": "learn a route and call it", "timeout": 300, "expect": {"in": {"how": ["learned", "called"]}, "has": ["result.data", "route.id"]}, "save": {"route": "route.id"}, "shot": {"url": "https://quotes.toscrape.com/"}, "journeys": ["learn-then-call"] },
    { "id": "do-calls", "tool": "unbrowse_do", "args": {"goal": "quotes", "url": "https://quotes.toscrape.com/"}, "what": "the same goal again is a call, no browser", "expect": {"in": {"how": ["called"]}, "has": ["result.data"]}, "shot": {"url": "https://quotes.toscrape.com/"}, "journeys": ["learn-then-call"] },
    { "id": "search", "tool": "unbrowse_search", "args": {"query": "quotes"}, "what": "search finds what was learned", "expect": {"has": ["routes"], "says": ["{{route}}"]}, "journeys": ["search-learned-route"] },
    { "id": "call-by-id", "tool": "unbrowse_call", "args": {"route_id": "{{route}}"}, "what": "call the route by its id", "expect": {"in": {"ok": [true]}, "has": ["data"]}, "shot": {"url": "https://quotes.toscrape.com/"}, "journeys": ["call-route-by-id"] },
    { "id": "inspect", "tool": "unbrowse_inspect", "args": {"route_id": "{{route}}"}, "what": "the route's makeup, no values", "journeys": ["inspect-route-makeup"] },
    { "id": "do-needs-hands", "tool": "unbrowse_do", "args": {"goal": "sign in", "url": "https://the-internet.herokuapp.com/login"}, "what": "a page that needs hands opens for them", "timeout": 300, "expect": {"in": {"how": ["browse"]}, "has": ["page", "next"]}, "shot": {"url": "https://the-internet.herokuapp.com/login"}, "journeys": ["browse-when-page-needs-hands"] },
    { "id": "browse-open", "tool": "unbrowse_browse", "args": {"do": ["open", "https://the-internet.herokuapp.com/login"], "session": "journey"}, "what": "open the page in the agent's own tab", "expect": {"has": ["site"]}, "shot": {"session": "journey"}, "journeys": ["browse-when-page-needs-hands"] },
    { "id": "observe", "tool": "unbrowse_observe", "args": {"site": "the-internet.herokuapp.com", "session": "journey"}, "what": "the open page as actions", "expect": {"result": "any"}, "shot": {"session": "journey"}, "journeys": ["browse-when-page-needs-hands"] },
    { "id": "browse-snapshot", "tool": "unbrowse_browse", "args": {"do": ["snapshot", "-i"], "session": "journey"}, "what": "the page's elements, by ref", "expect": {"says": ["Login"]}, "shot": {"session": "journey"}, "journeys": ["browse-when-page-needs-hands"] },
    { "id": "challenge-look", "tool": "unbrowse_challenge", "args": {"action": "look", "session": "journey"}, "what": "a page with no person check says it asks nothing", "expect": {"result": "any"}, "shot": {"session": "journey"}, "journeys": ["challenge-person-check"] },
    { "id": "refuse-executable", "tool": "unbrowse_browse", "args": {"do": ["open", "https://example.com", "--executable-path", "/bin/sh"], "session": "journey"}, "what": "an agent may not pick the browser program", "expect": {"result": "refused"}, "shot": {"session": "journey"}, "journeys": ["refuse-unsafe-commands"] },
    { "id": "refuse-cookies", "tool": "unbrowse_browse", "args": {"do": ["cookies", "clear"], "session": "journey"}, "what": "a command the node doesn't take", "expect": {"result": "refused"}, "shot": {"session": "journey"}, "journeys": ["refuse-unsafe-commands"] },
    { "id": "walk", "tool": "unbrowse_walk", "args": {"url": "https://quotes.toscrape.com/", "goal": "quotes"}, "what": "list a page's calls to pick one", "timeout": 300, "expect": {"result": "any"}, "shot": {"url": "https://quotes.toscrape.com/"}, "journeys": ["walk-pick-a-call"] },
    { "id": "do-no-url", "tool": "unbrowse_do", "args": {"goal": "qa check a goal no route has"}, "what": "an unknown goal without a page is a clear error", "expect": {"result": "refused"}, "journeys": ["unknown-goal-clear-error"] },
    { "id": "do-site-404", "tool": "unbrowse_do", "args": {"goal": "qa read a missing data file", "url": "https://api.github.com/repos/unbrowse-ai/qa-no-such-repo"}, "what": "a refusal carries the site's own words", "expect": {"result": "refused", "says": ["404"]}, "shot": {"url": "https://api.github.com/repos/unbrowse-ai/qa-no-such-repo"}, "journeys": ["data-url-and-site-refusal"] },
    { "id": "do-version", "tool": "unbrowse_do", "args": {"goal": "latest version of serde", "url": "https://crates.io/api/v1/crates/serde"}, "what": "a version number reads as itself, never {session}", "expect": {"in": {"how": ["learned", "called"]}, "has": ["result.data"], "never_says": ["{session}"]}, "journeys": ["versions-read-as-themselves"] },
    { "id": "judge-wrong", "tool": "unbrowse_judge", "args": {"route_id": "{{route}}", "verdict": "wrong", "url": "https://quotes.toscrape.com/", "why": "qa: judged wrong to check it is passed over"}, "what": "a route judged wrong for a page", "expect": {"has": ["judged.wrong_pages"]}, "journeys": ["judge-wrong-route"] },
    { "id": "judge-right", "tool": "unbrowse_judge", "args": {"route_id": "{{route}}", "verdict": "right", "url": "https://quotes.toscrape.com/"}, "what": "and judged right again", "journeys": ["judge-wrong-route"] },
    { "id": "open-preview", "tool": "unbrowse_open", "args": {"link": "unbrowse://news.ycombinator.com"}, "what": "a network preview, from a node off the network", "expect": {"result": "any"}, "journeys": ["network-link-preview"] },
    { "id": "report-off", "tool": "unbrowse_report", "args": {"kind": "wrong_data", "summary": "qa: top stories came back for another site", "expected": "Hacker News stories", "got": "stories for qa@example.com from https://news.ycombinator.com/item?id=123&auth=AbCdEf123456GhIjKl", "url": "https://news.ycombinator.com/?p=2", "route_id": "{{route}}"}, "what": "a report from a node off the network is scrubbed and sent nowhere", "expect": {"in": {"report": ["off"]}, "never_says": ["qa@example.com", "AbCdEf123456GhIjKl"]}, "journeys": ["report-wrong-data-scrubbed"] },
    { "id": "browse-close", "tool": "unbrowse_browse", "args": {"do": ["close"], "session": "journey"}, "what": "close the agent's tab", "journeys": ["browse-when-page-needs-hands"] }
  ],
  "waived": {}
}

{
  "name": "unbrowse-monorepo",
  "version": "11.4.0",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "packages/playwright-shim",
    "packages/firecrawl-shim",
    "packages/stagehand-shim"
  ],
  "scripts": {
    "prepare": "husky",
    "submodules:init": "bash scripts/ensure-submodules.sh",
    "openclaw:install": "bash scripts/install-openclaw-unbrowse.sh",
    "test": "bun run test:issue-regressions && bun test tests/path-params.test.ts tests/utils.test.ts tests/contract-recall-tier.test.ts tests/gui-contract-bridge.test.ts evals/quality-gate.test.ts",
    "test:cli": "bun test tests/cli-e2e.test.ts",
    "test:issue-regressions": "bun test ./tests/github-issue-regressions.test.ts ./tests/codex-harness.test.ts ./tests/codex-product-success-cases.test.ts",
    "test:triage": "bash scripts/test-triage.sh",
    "test:triage:json": "bash scripts/test-triage.sh --json",
    "test:triage:next": "bash scripts/test-triage.sh --next",
    "test:isolate": "bash scripts/test-isolate.sh",
    "test:all": "bun test tests/ evals/quality-gate.test.ts backend/tests/",
    "test:e2e:truth": "bash scripts/test-e2e-truth.sh",
    "test:openclaw-plugin": "bash scripts/ensure-submodules.sh && npm test --prefix submodules/openclaw-unbrowse-plugin",
    "typecheck:openclaw-plugin": "bash scripts/ensure-submodules.sh && npm run typecheck --prefix submodules/openclaw-unbrowse-plugin",
    "precommit": "bash scripts/precommit.sh",
    "precommit:full": "bash scripts/precommit-full.sh",
    "preset:prod": "bun scripts/profile.ts use prod",
    "preset:testing": "bun scripts/profile.ts use testing",
    "preset:experiments": "bun scripts/profile.ts use experiments",
    "preset:show": "bun scripts/profile.ts show",
    "preset:clear": "bun scripts/profile.ts clear",
    "check:surface": "bun scripts/surface-gate.ts",
    "check:version-consistency": "bun scripts/check-version-consistency.ts",
    "check:free-tier": "bun test tests/free-tier-anon.test.ts tests/auth-self-heal.test.ts",
    "check:privacy": "bun test tests/privacy-at-rest.test.ts",
    "check:skill-md": "bun scripts/check-skill-md.ts",
    "check:skill-docs": "bun scripts/check-skill-docs.ts",
    "check:kuri-vendor": "node packages/skill/scripts/assert-kuri-vendor.mjs",
    "pack:cli": "bun run check:kuri-vendor && npm pack --dry-run --workspace packages/skill",
    "publish:cli:preview": "node scripts/publish-preview-cli.mjs",
    "pack:sdk": "npm pack --dry-run --workspace packages/sdk",
    "publish:cli": "bun run check:kuri-vendor && UNBROWSE_ALLOW_SKILL_PUBLISH=1 node packages/skill/scripts/assert-release-flow.mjs --check-npm && npm_config_unbrowse_allow_skill_publish=true npm publish --workspace packages/skill",
    "publish:pollen": "UNBROWSE_ALLOW_SKILL_PUBLISH=1 npm_config_unbrowse_allow_skill_publish=true npm publish --workspace packages/pollen-cli --access public --ignore-scripts",
    "publish:direct": "UNBROWSE_ALLOW_SKILL_PUBLISH=1 npm_config_unbrowse_allow_skill_publish=true npm publish --workspace packages/skill --ignore-scripts && npm publish --workspace packages/sdk --ignore-scripts && npm publish --workspace packages/pollen-cli --access public --ignore-scripts",
    "publish:bee": "UNBROWSE_ALLOW_SKILL_PUBLISH=1 npm_config_unbrowse_allow_skill_publish=true npm publish --workspace packages/pollen-cli --access public",
    "release:announce": "bun scripts/release-announce.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "cli": "bun src/cli.ts",
    "clean": "bash scripts/clean.sh",
    "build:single": "bash scripts/build-binaries.sh",
    "release": "release-it",
    "check:backend-config-parity": "bash scripts/backend-config-parity.sh",
    "check:lifecycle": "bash scripts/check-lifecycle-witness.sh",
    "fuzz:protobuf": "bash scripts/run-fuzz.sh protobuf-wire",
    "fuzz:obscura": "bash scripts/run-fuzz.sh obscura-capture",
    "fuzz:rsc": "bash scripts/run-fuzz.sh rsc",
    "fuzz:smoke": "bash scripts/fuzz-smoke.sh"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@iqlabs-official/solana-sdk": "^0.1.27",
    "@puppeteer/browsers": "^2.13.2",
    "@solana/kit": "^6.6.0",
    "@solana/web3.js": "1",
    "bs58": "^6.0.0",
    "cheerio": "^1.2.0",
    "chrome-remote-interface": "^0.34.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "nanoid": "^5.1.6",
    "openai": "^7.4.0",
    "sodium-native": "^5.1.0",
    "turndown": "^7.2.4",
    "tweetnacl": "^1.0.3",
    "viem": "^2.47.11"
  },
  "devDependencies": {
    "@jazzer.js/core": "^4.0.0",
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^10.0.5",
    "@types/node": "^26.0.0",
    "@types/turndown": "^5.0.6",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "playwright": "^1.60.0",
    "release-it": "^19.2.4",
    "typescript": "5",
    "yaml": "^2.8.1"
  }
}

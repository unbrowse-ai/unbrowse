{
  "name": "unbrowse-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk",
    "packages/cli"
  ],
  "scripts": {
    "build": "bun run --filter '@unbrowse/sdk' build && bun run --filter 'unbrowse' build",
    "test": "bun test packages",
    "typecheck": "tsc -p packages/sdk --noEmit && tsc -p packages/cli --noEmit",
    "cli": "bun packages/cli/src/cli.ts",
    "check:public": "node scripts/check-public-surface.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}

{
  "name": "unbrowse",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "prepare": "husky",
    "test": "bun test tests/path-params.test.ts tests/utils.test.ts evals/quality-gate.test.ts",
    "test:backend": "bun test backend/tests/",
    "test:all": "bun test tests/ evals/quality-gate.test.ts backend/tests/",
    "eval": "bun evals/perf.ts",
    "eval:full": "bun evals/perf.ts --full",
    "eval:update": "bun evals/perf.ts --update-baseline",
    "cli": "bun src/cli.ts",
    "release": "release-it"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "agent-browser": "^0.13.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^10.0.5",
    "husky": "^9.1.7",
    "release-it": "^19.2.4"
  },
  "version": "1.1.0"
}

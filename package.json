{
  "name": "unbrowse-monorepo",
  "version": "9.4.7",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "packages/playwright-shim",
    "packages/firecrawl-shim",
    "packages/stagehand-shim"
  ],
  "scripts": {
    "prepare": "husky",
    "submodules:init": "bash scripts/ensure-submodules.sh",
    "openclaw:install": "bash scripts/install-openclaw-unbrowse.sh",
    "test": "bun run test:issue-regressions && bun test tests/path-params.test.ts tests/utils.test.ts evals/quality-gate.test.ts",
    "test:cli": "bun test tests/cli-e2e.test.ts",
    "test:issue-regressions": "bun test tests/github-issue-regressions.test.ts tests/codex-harness.test.ts tests/codex-product-success-cases.test.ts",
    "test:issue-worktree-skill": "bun test tests/issue-worktree-loop.test.ts",
    "test:triage": "bash scripts/test-triage.sh",
    "test:triage:json": "bash scripts/test-triage.sh --json",
    "test:triage:next": "bash scripts/test-triage.sh --next",
    "test:isolate": "bash scripts/test-isolate.sh",
    "test:all": "bun test tests/ evals/quality-gate.test.ts backend/tests/",
    "test:landing-funnel:e2e": "bun test tests/landing-funnel-e2e.test.ts",
    "test:e2e:truth": "bash scripts/test-e2e-truth.sh",
    "test:claims": "bun run test:e2e:truth && bun run eval:codex:product-success",
    "test:openclaw-plugin": "bash scripts/ensure-submodules.sh && npm test --prefix submodules/openclaw-unbrowse-plugin",
    "typecheck:openclaw-plugin": "bash scripts/ensure-submodules.sh && npm run typecheck --prefix submodules/openclaw-unbrowse-plugin",
    "precommit": "bash scripts/precommit.sh",
    "precommit:full": "bash scripts/precommit-full.sh",
    "preset:prod": "bun scripts/profile.ts use prod",
    "preset:testing": "bun scripts/profile.ts use testing",
    "preset:experiments": "bun scripts/profile.ts use experiments",
    "preset:show": "bun scripts/profile.ts show",
    "preset:clear": "bun scripts/profile.ts clear",
    "blog:publish": "bun scripts/publish-blog.ts",
    "optimize:landing-funnel": "bun scripts/landing-funnel-optimize.ts",
    "landing:publish": "bun scripts/publish-landing-variant.ts",
    "check:surface": "bun scripts/surface-gate.ts",
    "check:free-tier": "bun test tests/free-tier-anon.test.ts tests/auth-self-heal.test.ts",
    "check:privacy": "bun test tests/privacy-at-rest.test.ts",
    "check:skill-md": "bun scripts/check-skill-md.ts",
    "check:skill-docs": "bun scripts/check-skill-docs.ts",
    "check:kuri-vendor": "node packages/skill/scripts/assert-kuri-vendor.mjs",
    "pack:cli": "bun run check:kuri-vendor && npm pack --dry-run --workspace packages/skill",
    "publish:cli:preview": "node scripts/publish-preview-cli.mjs",
    "pack:sdk": "npm pack --dry-run --workspace packages/sdk",
    "issue:worktree:collect": "bun skills/worktree-issue-fix/scripts/issue-worktree-loop.ts collect",
    "issue:worktree:verify": "bun skills/worktree-issue-fix/scripts/issue-worktree-loop.ts verify",
    "capability:worktree:collect": "bun skills/worktree-issue-fix/scripts/issue-worktree-loop.ts collect",
    "capability:worktree:verify": "bun skills/worktree-issue-fix/scripts/issue-worktree-loop.ts verify",
    "publish:cli": "bun run check:kuri-vendor && UNBROWSE_ALLOW_SKILL_PUBLISH=1 node packages/skill/scripts/assert-release-flow.mjs --check-npm && npm_config_unbrowse_allow_skill_publish=true npm publish --workspace packages/skill",
    "release:announce": "bun scripts/release-announce.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "cli": "bun src/cli.ts",
    "build:single": "bash scripts/build-binaries.sh",
    "release": "release-it",
    "release:preview": "bash scripts/release-and-verify.sh",
    "release:preview:local": "bash scripts/release-and-verify.sh --skip-remote",
    "release:verify-remote": "bash scripts/release-and-verify.sh --skip-release",
    "test:agent-xp": "bash scripts/agent-experience-test.sh",
    "test:agent-xp:remote": "bash scripts/agent-experience-test.sh --remote lekt8@89.169.121.108",
    "agent-xp": "bash harness/probes/agent-experience.sh",
    "agent-xp:judge": "bash harness/probes/run-and-judge.sh",
    "agent-xp:rank": "bash harness/probes/rank-evidence.sh",
    "bench:gate": "~/.claude/skills/contract/scripts/aiko 'bench-gate'",
    "bench:gate:judge": "bun scripts/bench-gate-judge.ts",
    "bench:gate:validate": "bun scripts/bench-gate-judge.ts --validate",
    "bench:gate:compare": "bun scripts/bench-gate-compare.ts",
    "bench:gate:stamp": "bun scripts/bench-gate-compare.ts --stamp",
    "bench:gate:prerelease": "~/.claude/skills/contract/scripts/aiko 'bench-gate-prerelease'",
    "bench:gate:refresh-corpus": "bash scripts/refresh-bench-corpus.sh",
    "bench:gate:freeze": "bun scripts/bench-gate-compare.ts --freeze",
    "bench:gate:full": "~/.claude/skills/contract/scripts/aiko 'bench-gate-full'",
    "bench:gate:mcp": "~/.claude/skills/contract/scripts/aiko 'bench-gate-mcp'",
    "bench:gate:mcp:collect": "bun scripts/bench-gate-mcp-collect.ts",
    "bench:corpus:validate": "bun scripts/bench-corpus.ts validate",
    "bench:corpus:add": "bun scripts/bench-corpus.ts add",
    "bench:improve:triage": "bun scripts/bench-improve-triage.ts",
    "bench:history:record": "bun scripts/bench-history-record.ts",
    "bench:history:release-notes": "bun scripts/bench-history-release-notes.ts",
    "bench:mcp": "~/.claude/skills/contract/scripts/aiko 'bench-mcp'",
    "bench:mcp:judge": "bun scripts/bench-mcp-judge.ts",
    "bench:mcp:telemetry": "bun scripts/bench-mcp-telemetry.ts",
    "bench:targeted": "~/.claude/skills/contract/scripts/aiko 'bench-targeted'",
    "bench:targeted:dry-run": "~/.claude/skills/contract/scripts/aiko 'bench-targeted --dry-run'",
    "matrix": "bun scripts/matrix/run.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@puppeteer/browsers": "^2.13.2",
    "@solana-program/compute-budget": "^0.15.0",
    "@solana/kit": "^6.6.0",
    "@solana/web3.js": "1",
    "@types/turndown": "^5.0.6",
    "@x402/fetch": "^2.9.0",
    "bs58": "^6.0.0",
    "cheerio": "^1.2.0",
    "chrome-remote-interface": "^0.34.0",
    "dotenv": "^17.3.1",
    "ethers": "6",
    "fastify": "^5.7.4",
    "nanoid": "^5.1.6",
    "sodium-native": "^5.1.0",
    "turndown": "^7.2.4",
    "viem": "^2.47.11"
  },
  "devDependencies": {
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "playwright": "^1.60.0",
    "release-it": "^19.2.4",
    "typescript": "5"
  }
}

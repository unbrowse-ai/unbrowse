{
  "name": "unbrowse-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "prepare": "husky",
    "submodules:init": "bash scripts/ensure-submodules.sh",
    "test": "bun test tests/path-params.test.ts tests/mcp.test.ts tests/utils.test.ts tests/codex-repeatability-cases.test.ts tests/repeatability-gate.test.ts tests/marketplace-retrieval-eval.test.ts tests/marketplace-retrieval-cases.test.ts tests/many-domains-gate.test.ts evals/quality-gate.test.ts",
    "test:cli": "bun test tests/cli-e2e.test.ts",
    "test:backend": "bun test backend/tests/",
    "test:all": "bun test tests/ evals/quality-gate.test.ts backend/tests/",
    "test:openclaw-plugin": "bash scripts/ensure-submodules.sh && npm test --prefix integrations/openclaw",
    "typecheck:openclaw-plugin": "bash scripts/ensure-submodules.sh && npm run typecheck --prefix integrations/openclaw",
    "precommit": "bash scripts/precommit.sh",
    "precommit:full": "bash scripts/precommit-full.sh",
    "eval:codex": "bun -e 'import { runHarnessCli } from \"./evals/codex-harness.js\"; await runHarnessCli()' --",
    "eval:codex:auth": "bun evals/codex-auth-runner.ts --restart-server",
    "eval:codex:auth:demos": "bun evals/codex-auth-runner.ts --suite scripted-demo --restart-server",
    "eval:codex:webarena": "UNBROWSE_FORCE_CAPTURE=0 bun evals/codex-auth-runner.ts --cases evals/codex-cases.webarena.json --benchmark --restart-server",
    "eval:codex:webarena:auth-demo": "UNBROWSE_FORCE_CAPTURE=0 bun evals/codex-auth-runner.ts --cases evals/codex-cases.webarena.auth-demo.json --benchmark --restart-server",
    "eval:codex:autonomous": "bun evals/codex-autonomous-harness.ts",
    "eval:codex:autonomous:benchmark": "bun evals/codex-autonomous-harness.ts --benchmark",
    "eval:codex:campaign": "bun evals/codex-campaign-runner.ts",
    "eval:codex:product-success": "UNBROWSE_FORCE_CAPTURE=0 bun evals/codex-autonomous-harness.ts --cases evals/codex-cases.product-success.json --restart-server",
    "eval:codex:many-domains": "UNBROWSE_FORCE_CAPTURE=0 bun evals/codex-autonomous-harness.ts --cases evals/codex-cases.public-expansion.json --out evals/codex-many-domains-last-run.json",
    "eval:codex:many-domains:gate": "bun scripts/eval-many-domains-gate.ts --run",
    "eval:codex:repeatability": "UNBROWSE_FORCE_CAPTURE=0 bun evals/codex-autonomous-harness.ts --benchmark --cases evals/codex-cases.repeatability.json --out evals/codex-repeatability-last-run.json",
    "eval:codex:repeatability:report": "bun scripts/eval-repeatability-report.ts --run",
    "eval:codex:repeatability:gate": "bun scripts/eval-repeatability-gate.ts --run",
    "eval:retrieval": "bun test tests/marketplace-retrieval-eval.test.ts",
    "eval:retrieval:live": "bun scripts/eval-marketplace-retrieval.ts",
    "eval:marketplace:retrieval": "bun scripts/eval-marketplace-retrieval.ts",
    "eval:webarena:verified:inventory": "bun scripts/eval-webarena-verified.ts --inventory --subset full",
    "eval:webarena:verified:stable": "bun scripts/eval-webarena-verified.ts --task-ids 11,15,21,25,28,29",
    "eval:webarena:verified:hard": "bun scripts/eval-webarena-verified.ts --subset hard",
    "eval:webarena:verified:full": "bun scripts/eval-webarena-verified.ts --subset full",
    "eval:core": "npm run eval:retrieval && npm run eval:codex:product-success && npm run eval:codex:webarena && npm run eval:webarena:verified:stable",
    "eval:full": "npm run eval:core && npm run eval:codex:auth",
    "eval:release:public": "npm run eval:core",
    "eval:release:full": "npm run eval:full",
    "eval:codex:stress": "UNBROWSE_FORCE_CAPTURE=0 bun -e 'import { runHarnessCli } from \"./evals/codex-harness.js\"; await runHarnessCli()' -- --cases evals/codex-cases.stress.json",
    "eval:codex:public": "bun run eval:codex:product-success",
    "eval:codex:agent-targets": "bun run eval:codex:stress",
    "build:codex:campaign-seed": "bun scripts/build-codex-campaign-seed.ts",
    "preset:prod": "bun scripts/profile.ts use prod",
    "preset:testing": "bun scripts/profile.ts use testing",
    "preset:show": "bun scripts/profile.ts show",
    "preset:clear": "bun scripts/profile.ts clear",
    "sync:webarena-verified-adapted": "bun scripts/adapt-webarena-verified.ts",
    "check:webarena-verified-adapted": "bun scripts/adapt-webarena-verified.ts --check",
    "sync:resolve-execute-adapted": "bun scripts/adapt-resolve-execute-csv.ts",
    "check:resolve-execute-adapted": "bun scripts/adapt-resolve-execute-csv.ts --check",
    "sync:skill-md": "bun scripts/sync-skill-md.ts",
    "check:skill-md": "bun scripts/sync-skill-md.ts --check",
    "sync:integration-versions": "bun scripts/sync-integration-versions.mjs",
    "check:integration-versions": "bun scripts/sync-integration-versions.mjs --check",
    "pack:cli": "npm pack --dry-run --workspace packages/skill",
    "release:local": "bash scripts/release-local.sh",
    "publish:cli": "UNBROWSE_ALLOW_SKILL_PUBLISH=1 node packages/skill/scripts/assert-release-flow.mjs --check-npm && npm_config_unbrowse_allow_skill_publish=true npm publish --workspace packages/skill",
    "release:announce": "bun scripts/release-announce.ts",
    "cli": "bun src/cli.ts",
    "dev:restart": "bash scripts/dev-restart.sh",
    "dev:server": "bash scripts/dev-restart.sh",
    "release": "release-it"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^10.0.5",
    "husky": "^9.1.7",
    "release-it": "^19.2.4"
  },
  "version": "2.1.6"
}

[{"title":"Parameters","link":"/en-US/docs/Glossary/Stringifier","url":"/en-US/docs/Glossary/Stringifier","description":"This defines the resource that you wish to fetch. This can either be:","definition":"This defines the resource that you wish to fetch. This can either be:\n\nA string or any other object with a stringifier — including a URL object — that provides the URL of the resource you want to fetch. The URL may be relative to the base URL, which is the document's baseURI in a window context, or WorkerGlobalScope.location in a worker context.\nA Request object."},{"title":"Return value","link":"/en-US/docs/Web/JavaScript/Reference/Global_Objects/Promise","url":"/en-US/docs/Web/JavaScript/Reference/Global_Objects/Promise","description":"A Promise that resolves to a Response object."},{"title":"Exceptions","link":"/en-US/docs/Web/API/DOMException","url":"/en-US/docs/Web/API/DOMException","description":"The request was aborted due to a call to the AbortController\nabort() method.","definition":"The request was aborted due to a call to the AbortController\nabort() method."},{"title":"Examples","link":"https://github.com/mdn/dom-examples/tree/main/fetch/fetch-request","url":"https://github.com/mdn/dom-examples/tree/main/fetch/fetch-request","description":"In our Fetch Request example (see Fetch Request live) we\ncreate a new Request object using the relevant constructor, then fetch it\nusing a fetch() call. Since we are fetching an image, we run\nResponse.blob() on the response to give it the proper MIME type so it will be\nhandled properly, then create an Object URL of it and display it in an\n element."},{"title":"Specifications","link":"https://fetch.spec.whatwg.org/#fetch-method","url":"https://fetch.spec.whatwg.org/#fetch-method"},{"title":"See also","link":"/en-US/docs/Web/API/WorkerGlobalScope/fetch","url":"/en-US/docs/Web/API/WorkerGlobalScope/fetch"}]
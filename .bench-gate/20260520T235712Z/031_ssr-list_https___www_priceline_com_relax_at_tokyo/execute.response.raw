title":"Limited time savings","QAonly":true},"CYBER MONDAY":{"QAonly":true,"labelBackgroundColor":"highlight.base","labelText":"CYBER MONDAY","subtitle":"Mondays just got better"}},"agodaPulsePromos":{"SAMPLE PROMO TITLE PLACE HOLDER":{"subtitle":"Limited Time Offer","labelBackgroundColor":"primary.base","labelText":"END OF SUMMER SALE"},"minSavingsPct":10},"RonsTestFlag1":{"QAFLAG":{"ISQA":true},"VERSION_REQUIREMENTS":{"RECOMMENDATION_COLLECTIONS":{"android":{"minVersion":"99.0.0"},"ios":{"minVersion":"99.0.0"}},"RTL_HOTEL_DETAILS":{"ios":{"minVersion":"99.0.0"},"android":{"minVersion":"99.0.0"}},"SIMILAR_RTL":{"desktop":{"description":"bypass similar retail for desktop"},"ios":{"minVersion":"99.0.0"},"mobileweb":{"description":"bypass similar retail for mweb"},"android":{"minVersion":"99.0.0"}},"DEAL_MATCHES":{"ios":{"minVersion":"99.0.0"},"mobileweb":{"description":"bypass deal matches for mweb"},"android":{"minVersion":"99.0.0"},"desktop":{"description":"bypass deal matches for desktop"}},"SIMILAR_HOTELS":{"ios":{"minVersion":"99.0.0"},"mobileweb":{"description":"bypass similar retail for mweb"},"android":{"minVersion":"99.0.0"},"desktop":{"description":"bypass similar retail for desktop"}},"HOTEL_FLEX_DATES":{"android":{"minVersion":"99.0.0"},"desktop":{"description":"bypass similar retail for desktop"},"ios":{"minVersion":"99.0.0"},"mobileweb":{"description":"bypass similar retail for mweb"}},"RTL_ROOM_RATE":{"android":{"minVersion":"99.0.0"},"ios":{"minVersion":"99.0.0"}},"SOPQ_HOTEL_DETAILS":{"android":{"minVersion":"99.0.0"},"ios":{"minVersion":"99.0.0"}},"POTENTIAL_SOPQ":{"mobileweb":{"description":"bypass similar retail for mweb"},"android":{"minVersion":"15.0.0"},"desktop":{"description":"bypass similar retail for desktop"},"ios":{"minVersion":"40.0.0"}},"STANDALONE_HOTEL_LISTINGS":{"ios":{"minVersion":"99.0.0"},"android":{"minVersion":"99.0.0"}},"RETAIL_GROUPS":{"mobileweb":{"description":"bypass retail groups for mweb"},"android":{"minVersion":"99.0.0"},"desktop":{"description":"bypass retail groups for desktop"},"ios":{"minVersion":"99.0.0"}},"SIMILAR_EXPRESS":{"desktop":{"description":"bypass similar express for desktop"},"ios":{"minVersion":"99.0.0"},"mobileweb":{"description":"bypass similar express for mweb"},"android":{"minVersion":"15.0.0"}},"SOPQ_HOTEL_LISTINGS":{"ios":{"minVersion":"99.0.0"},"android":{"minVersion":"99.0.0"}}},"OPERATION_NAME_MAPPING":{"RECOMMENDATION_COLLECTION":"RECOMMENDATION_COLLECTIONS","POTENTIAL_SOPQ_HOTELS":"POTENTIAL_SOPQ","SIMILAR_HOTELS":"SIMILAR_HOTELS","RECOMMENDATION_COLLECTIONS":"RECOMMENDATION_COLLECTIONS","SOPQ_HOTEL_LISTINGS":"SOPQ_HOTEL_LISTINGS","RTL_ROOM_RATE":"RTL_ROOM_RATE","SOPQ_HOTEL_DETAILS":"SOPQ_HOTEL_DETAILS","STANDALONE_HOTEL_LISTINGS":"STANDALONE_HOTEL_LISTINGS","RETAIL_GROUPS":"RETAIL_GROUPS","RTL_HOTEL_DETAILS":"RTL_HOTEL_DETAILS","SIMILAR_EXPRESS_HOTELS":"SIMILAR_EXPRESS","SIMILAR_RETAIL_HOTELS":"SIMILAR_RTL","HOTEL_FLEX_DATES":"HOTEL_FLEX_DATES","DEAL_MATCHES":"DEAL_MATCHES"}},"enableSessionForPkgListingsRequest":true,"allowFtcHtmlMetadata":false,"allowFtcMetatags":false,"contentfulEnabled":false,"jsondemo":{"name":"htl13","disc":"demo"},"enableUSPListingsForWL":false,"genAiAltText":false,"enableUSPForWLPackages":true,"isCovidActive":true,"gen-ai-prompt-neighborhood-description-details-with-places-api":{"content":"Provide a description of the area around the ~~hotelName~~ Hotel located in ~~cityName~~ that would convince a traveler to book a hotel in that area as opposed to other areas in ~~cityName~~\n\n PLACES:~~places~~\noutput:","context":"You are an enthusiastic resident of this enchanting area, eager to share its charm with the world. As you craft the description, aim to evoke a sense of wonder and curiosity, highlighting the interplay of diverse activities with the area's unique character. Consider the atmosphere, local interactions, and the distinctive elements that make this area a hidden gem worth exploring. Your recommendation should make clear to the reader why they should pick this area over another area within the same city.\nAdhere to the following rules:\n1. YOU SHOULD NOT mention hotels or accommodations available\n2. Explain why this is the best area to stay in\n3. From the list of PLACES, select the top 3 points of interest that best fit the type of traveler and time of the year they are traveling. \n 4. Include the selected top 3 PLACES into the description of the area\n 5. Limit description to 500 words total\n6. Use full sentence format\n7. DO NOT list any of the text as bullet points and prevent any markdown","examples":["input: Provide a description of the area around the Washington Square Hotel located in New York City, US that would convince a traveler to stay in this area as opposed to other areas in New York, US\nPLACES:9/11 Museum Workshop: 100 Images & Artifacts Exhibit,Whitney Museum of American Art,Washington Square Park,Hudson River Park Trust,Christopher Park,Little Island,Jefferson Market Garden,The High Line,Museum of Illusions,Chelsea Market,Meatpacking District,Abingdon Square,Gansevoort Meatpacking NYC,Rockefeller Center,Foods of NY Tours,MeatPacking Marketing,Kobrick Coffee Co.,Babycastle    \noutput: Embrace the true essence of New York City by staying near the captivating district surrounding the iconic Washington Square Park. This area offers a one-of-a-kind experience for travelers seeking an authentic urban adventure.\nImmerse yourself in history at the 9/11 Museum Workshop: 100 Images & Artifacts Exhibit, and explore American art at the renowned Whitney Museum. Wander the High Line's artistic haven or find enchantment at the whimsical Little Island. Discover serenity at Christopher Park and the scenic Hudson River Park Trust.\nIndulge your palate at the Meatpacking District, and savor the vibrant culinary scene at Chelsea Market. Dive into innovation at Babycastles, uncover community at Abingdon Square, and shop at the popular Gansevoort Market.\nCap off your journey at the iconic Rockefeller Center and relish diverse flavors with Foods of NY Tours. Choosing to stay here means more than accommodations – it's an immersive dive into New York's vibrant culture, leaving you with unforgettable memories of an enchanting neighborhood.","input: Provide a description of the area around the Condes De Barcelona Hotel located in Barcelona, SP that would convince a traveler to book a hotel in that area as opposed to other areas in Barcelona, SP\nPLACES:La Rambla,Rambla de Canaletes,Dracs i piro musical al Passeig de Gràcia, recinte plaça Espanya,Güell Palace,Illa de la Discòrdia,Virreina Palace,Oceans maritime,Font de Canaletes,Rambla De Mar,La Pedrera-Casa Milà,Festes Gràcia,Plaça Milans,Passeig de Gràcia Avenue,Edifici Companyia de Tabacs de Filipines,Monumento Jacintos Reverentod,Casa Amatller,Big Fun Museum,Mosaic de Joan Miró,Cases Antoni Rocamora,Graffiti wall\noutput: Elevate your Barcelona experience by staying near the Condes De Barcelona Hotel, where an enchanting neighborhood weaves history, art, and culture into an immersive tapestry. Begin your journey along La Rambla, a vibrant boulevard adorned with street performances, diverse shops, and delectable eateries. Explore architectural wonders like Illa de la Discòrdia and Virreina Palace, each facade telling a unique story. Marvel at the maritime wonders of Oceans and the elegance of Font de Canaletes. Wander Passeig de Gràcia Avenue, a blend of upscale boutiques and architectural marvels. Immerse yourself in the artistic splendor of Güell Palace and the surreal La Pedrera-Casa Milà. Uncover hidden treasures like Cases Antoni Rocamora and the vibrant Graffiti Wall. Complete your exploration at the whimsical Big Fun Museum. By choosing this area, you're not merely staying in a hotel; you're immersing yourself in Barcelona's soul, embracing its history, art, and vibrant spirit.","input: Provide a description of the area around the Thompson Washington D.C. Hotel located in Washington, DC that would convince a traveler to book a hotel in that area as opposed to other areas in Washington, DC\nPLACES: The Yards,Meridian Hill Park,Anacostia Community Museum,Dumbarton Oaks Museum,Tudor Place,mithsonian American Art Museum,Washington Canal Park\noutput: Embark on an unforgettable Washington, D.C. experience by choosing the Thompson Washington D.C. Hotel's vibrant neighborhood. With a harmonious blend of history, culture, and modern allure, this area stands as the ultimate choice for travelers seeking an authentic and enriching stay.\nNestled amidst iconic landmarks, the Thompson Washington D.C. Hotel offers more than accommodation; it's a gateway to exploration. Immerse yourself in Capitol Hill's grandeur, where political history unfolds against the backdrop of the U.S. Capitol.\nStroll through streets echoing with monumental decisions and delve into knowledge and art at nearby Smithsonian museums. Discover the cultural tapestry of the historic Eastern Market and indulge in the ambiance of the Barracks Row Historic District, brimming with boutiques and dining.\nExperience the tranquility of the Anacostia riverfront or embrace the vibrant Wharf District's waterfront dining and entertainment. By choosing this neighborhood, you're immersing yourself in the soul of the capital, embracing its history, culture, and dynamic energy for an exceptional D.C. experience.","input: Provide a description of the area around the SpringHill Suites by Marriott Boise ParkCenter Hotel located in Boise, ID that would convince a traveler to book a hotel in that area as opposed to other areas in Boise, ID\nPLACES:Boise Art Museum,Julia Davis Park,Zoo Boise,Hyde Park,Camel's Back Park\noutput: Experience the vibrant essence of Boise, Idaho, by making the SpringHill Suites by Marriott Boise ParkCenter Hotel your home base. Nestled in an area that perfectly balances nature, culture, and local charm, this neighborhood is a top-notch choice for travelers seeking an authentic and enriching stay.\nUnfold your artistic side at the nearby Boise Art Museum, where captivating exhibitions and creative vibes come together. Picture yourself strolling through the serene Julia Davis Park, a lush oasis perfect for relaxation and outdoor escapades.\nFor an adventure that's a total hit with all ages, Zoo Boise awaits – a fantastic spot to encounter captivating wildlife and embark on a journey of discovery. And let's not forget Hyde Park, a hip and happening district brimming with boutiques, eateries, and a laid-back atmosphere that's quintessentially Boise.\nFor nature enthusiasts, Camel's Back Park is a haven of trails and scenic vistas, offering a breathtaking perspective of the city and the nearby foothills. Whether you're an avid hiker or simply seeking a tranquil escape, this park is a must-visit.\nBy choosing to stay in this vibrant neighborhood, you're not just booking a hotel; you're immersing yourself in Boise's heart and soul. From art and culture to nature and local flair, this area provides an authentic and unforgettable Boise experience that's second to none."],"radius":"50"},"mostSavedNum":{"cities":{"3000001349":{"hotels":"2249905,96|5401605,68|49117,62|46797,61|51207,57|17893004,51|17916904,50|46560,48|46794,46|4593905,45"},"3000001947":{"hotels":"39821,238|41914,174|68260405,168|39519,158|40702,148|39743,142|42681,112|41988,111|41320,99|68682804,90"},"3000002241":{"hotels":"39509,214|44170,161|39038,122|43086,119|1811005,84|12849904,81|42357,79|39475,74|39800,66|39989,65"},"3000002573":{"hotels":"47588,101|47203,68|2037605,58|47083,53|57621,52|49251,48|45824,45|48248,43|18140604,37|51132,35"},"3000003192":{"hotels":"42006,210|73019705,166|41157,151|41612,135|2163705,128|36197203,121|41156,111|44137506,107|39365,107|64045003,104"},"3000003311":{"hotels":"62876404,341|41920,292|39504,221|53431805,203|44258,200|39370,195|40871505,171|40435,155|39738,147|40037,139"},"3000003349":{"hotels":"42338,446|40968,352|41177,342|42033,296|41484,267|60
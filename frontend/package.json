{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "codegen:docs": "node scripts/codegen-docs.mjs",
    "prebuild": "node scripts/codegen-docs.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "node scripts/codegen-docs.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:gated": "bash scripts/four-dim-gate.sh && node scripts/codegen-docs.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:ci": "node scripts/codegen-docs.mjs && opennextjs-cloudflare build && OPEN_NEXT_DEPLOY=true wrangler deploy",
    "four-dim-gate": "bash scripts/four-dim-gate.sh",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@gitbook/embed": "^0.4.0",
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@opennextjs/cloudflare": "^1.15.1",
    "@privy-io/react-auth": "^3.26.0",
    "@wallet-standard/app": "^1.1.0",
    "@wallet-standard/base": "^1.1.0",
    "lenis": "1.1.18",
    "lucide-react": "^0.577.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "next": "16.1.5",
    "puppeteer": "^24.42.0",
    "react": "19.1.5",
    "react-dom": "19.1.5",
    "server-only": "^0.0.1",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.3",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.3.0",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "axe-core": "^4.11.4",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "jimp": "^1.6.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "wrangler": "^4.67.0"
  }
}

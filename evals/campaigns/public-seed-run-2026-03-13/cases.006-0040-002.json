            "url": "https://opensource-demo.orangehrmlive.com/web/index.php/dashboard/index",
            "expected_fields": [
              "title"
            ],
            "validate": {
              "min_rows": 2
            }
          }
        ],
        "verify": [
          {
            "id": "dashboard-widgets-warm",
            "intent": "get dashboard widgets",
            "url": "https://opensource-demo.orangehrmlive.com/web/index.php/dashboard/index",
            "expected_fields": [
              "title"
            ],

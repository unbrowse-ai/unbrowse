{
  "cases": [
    {
      "id": "practice-test-automation-success",
      "suite": "scripted-demo",
      "site": "practicetestautomation.com",
      "intent": "get login success message",
      "url": "https://practicetestautomation.com/logged-in-successfully/",
      "auth": {
        "domain": "practicetestautomation.com",
        "persona": "qa-user",
        "role": "member",
        "session": "primary"
      },
      "expected_fields": [
        "title",
        "message"
      ],
      "validate": {
        "terminal_ok": [
          "pass"
        ]
      },
      "auth_bootstrap": {
        "strategy": "scripted_login",
        "login_url": "https://practicetestautomation.com/practice-test-login/",
        "success_url": "https://practicetestautomation.com/logged-in-successfully/",
        "username": "student",
        "password": "Password123",
        "steps": [
          {
            "action": "fill",
            "selector": "#username",
            "value": "$USERNAME"
          },
          {
            "action": "fill",
            "selector": "#password",
            "value": "$PASSWORD"
          },
          {
            "action": "click",
            "selector": "#submit"
          },
          {
            "action": "wait_for_url",
            "pattern": "**/logged-in-successfully/"
          }
        ]
      }
    },
    {
      "id": "orangehrm-dashboard",

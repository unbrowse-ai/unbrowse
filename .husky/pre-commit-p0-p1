#!/bin/sh
# Pre-commit hook for P0/P1 issue validation
# This hook runs P0/P1 tests if test cases exist
# Set SKIP_P0_P1_TESTS=1 to skip these tests

if [ "$SKIP_P0_P1_TESTS" = "1" ]; then
  echo "⏭️  Skipping P0/P1 tests (SKIP_P0_P1_TESTS=1)"
  exit 0
fi

# Check if test cases file exists
TEST_CASES_FILE="tests/p0-p1-issues.json"
if [ ! -f "$TEST_CASES_FILE" ]; then
  echo "⚠️  No P0/P1 test cases found. Generate with: bun run test:p0-p1:generate"
  exit 0
fi

echo "🧪 Running P0/P1 issue validation tests..."
bun run test:p0-p1

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ P0/P1 tests failed!"
  echo ""
  echo "To fix:"
  echo "  1. Review test failures in evals/p0-p1-test-results.json"
  echo "  2. Update tests/p0-p1-issues.json with correct URLs/intents"
  echo "  3. Run: bun run test:p0-p1 again"
  echo ""
  echo "To skip this check (not recommended):"
  echo "  SKIP_P0_P1_TESTS=1 git commit ..."
  exit 1
fi

echo "✅ P0/P1 tests passed!"
exit 0

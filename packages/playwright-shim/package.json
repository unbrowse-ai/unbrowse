{
  "name": "@unbrowse/playwright-shim",
  "version": "0.1.0",
  "description": "Drop-in replacement for playwright that routes goto/click/fill/evaluate through Unbrowse's resolved-route cache. Same import line, same API surface, pays per-call instead of per-browser-hour.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chromium": {
      "types": "./dist/chromium.d.ts",
      "import": "./dist/chromium.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/chromium.ts --outdir dist --target node --format esm && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "bun test"
  },
  "keywords": [
    "playwright",
    "browser-automation",
    "unbrowse",
    "scraping",
    "shim"
  ],
  "license": "MIT",
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "@unbrowse/sdk": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unbrowse-ai/unbrowse"
  },
  "bugs": {
    "url": "https://github.com/unbrowse-ai/unbrowse/issues"
  },
  "homepage": "https://unbrowse.ai/vs/playwright"
}

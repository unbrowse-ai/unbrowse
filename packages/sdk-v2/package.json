{
  "name": "@unbrowse/client",
  "version": "7.0.0-preview.1",
  "description": "Thin HTTP-first SDK for the Unbrowse API. Browser + Node 18+. Zero runtime deps.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=18" },
  "keywords": ["unbrowse", "agent", "browser", "api", "sdk"],
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}

{
  "name": "@unbrowse/sdk",
  "version": "9.9.0-preview.2",
  "description": "TypeScript SDK for Unbrowse — auto-spawns the unbrowse binary and talks to it over a local socket. For an HTTP-first, browser/edge-compatible client with zero runtime deps, see @unbrowse/client.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:smoke": "bun test test/integration.smoke.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "unbrowse": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "unbrowse": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "unbrowse": "^9.8.0",
    "@faremeter/flex-solana": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^6.0.2"
  }
}

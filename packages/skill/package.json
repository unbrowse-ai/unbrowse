{
  "name": "unbrowse",
  "version": "2.11.0",
  "description": "Reverse-engineer any website into reusable API skills. Zero-dep single binary with embedded browser engine.",
  "type": "module",
  "bin": {
    "unbrowse": "bin/unbrowse-wrapper.mjs"
  },
  "files": [
    "bin/unbrowse-wrapper.mjs",
    "scripts/release-assets.mjs",
    "scripts/postinstall.mjs",
    "scripts/verify-release-assets.mjs",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "bun ../../scripts/sync-skill-md.ts --check && node scripts/prepare-pack.mjs",
    "prepublishOnly": "node scripts/assert-release-flow.mjs && node scripts/verify-release-assets.mjs"
  }
}

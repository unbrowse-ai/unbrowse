// The dashboard in production: deployed only by the release train after staging soaks. Deploys the Vite build.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unbrowse-dashboard",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "find_additional_modules": true,
  "base_dir": "dist/server",
  "rules": [{ "type": "ESModule", "globs": ["**/*.js"] }],
  "assets": { "directory": "dist/client" },
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "unbrowse-dashboard", "database_id": "584627a3-d726-4386-9da9-be67b8f64a61", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}

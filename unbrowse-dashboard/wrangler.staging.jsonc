// The dashboard on staging: its own Worker and D1. Deploys the Vite build (npm run build first).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unbrowse-dashboard-staging",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "find_additional_modules": true,
  "base_dir": "dist/server",
  "rules": [{ "type": "ESModule", "globs": ["**/*.js"] }],
  "assets": { "directory": "dist/client" },
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "unbrowse-dashboard-staging", "database_id": "ae9b0923-aa47-4830-804f-8ff5fa32f718", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}

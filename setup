#!/usr/bin/env bash
# unbrowse setup — install deps, register skill with agent hosts, bootstrap runtime
# Usage: ./setup [--host claude|codex|opencode|auto] [--no-start]
set -e

SOURCE_DIR="$(cd "$(dirname "$0")" && pwd -P)"

# ─── Colors ───────────────────────────────────────────────────
if [ -t 1 ]; then
  GREEN="\033[32m" YELLOW="\033[33m" RED="\033[31m" CYAN="\033[36m" RESET="\033[0m"
else
  GREEN="" YELLOW="" RED="" CYAN="" RESET=""
fi

info() { printf "${CYAN}[unbrowse]${RESET} %s\n" "$*"; }
warn() { printf "${YELLOW}[unbrowse]${RESET} %s\n" "$*" >&2; }
fail() { printf "${RED}[unbrowse]${RESET} %s\n" "$*" >&2; exit 1; }
ok()   { printf "${GREEN}[unbrowse]${RESET} %s\n" "$*"; }

# ─── Parse flags ──────────────────────────────────────────────
AGENT_HOST="auto"
CLI_FLAGS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --host)      [ -z "$2" ] && fail "Missing value for --host"; AGENT_HOST="$2"; shift 2 ;;
    --host=*)    AGENT_HOST="${1#--host=}"; shift ;;
    --no-start)  CLI_FLAGS="$CLI_FLAGS --no-start"; shift ;;
    *)           shift ;;
  esac
done

case "$AGENT_HOST" in
  claude|codex|opencode|auto) ;;
  *) fail "Unknown --host value: $AGENT_HOST (expected claude, codex, opencode, or auto)" ;;
esac

# ─── 1. Check prerequisites ──────────────────────────────────
BUN_OK=0
NODE_OK=0

command -v bun  >/dev/null 2>&1 && BUN_OK=1
command -v node >/dev/null 2>&1 && NODE_OK=1

if [ "$BUN_OK" -eq 0 ] && [ "$NODE_OK" -eq 0 ]; then
  fail "Node.js or Bun is required but neither is installed.
  Install Node.js: https://nodejs.org/ (v18+)
  Install Bun:     https://bun.sh/"
fi

if [ "$NODE_OK" -eq 1 ] && [ "$BUN_OK" -eq 0 ]; then
  NODE_MAJOR=$(node -e "process.stdout.write(process.versions.node.split('.')[0])")
  if [ "$NODE_MAJOR" -lt 18 ] 2>/dev/null; then
    fail "Node.js v18+ required (found v${NODE_MAJOR}). Update: https://nodejs.org/"
  fi
fi

# ─── 2. Install dependencies ─────────────────────────────────
if [ ! -d "$SOURCE_DIR/node_modules" ]; then
  info "Installing dependencies..."
  (
    cd "$SOURCE_DIR"
    if [ "$BUN_OK" -eq 1 ]; then
      bun install --frozen-lockfile 2>/dev/null || bun install
    else
      npm install
    fi
  )
fi

# ─── 3. Register skill with agent hosts ──────────────────────
INSTALL_CLAUDE=0
INSTALL_CODEX=0

if [ "$AGENT_HOST" = "auto" ]; then
  [ -d "$HOME/.claude" ] || command -v claude >/dev/null 2>&1 && INSTALL_CLAUDE=1
  [ -d "$HOME/.codex" ]  || command -v codex  >/dev/null 2>&1 && INSTALL_CODEX=1
  # Default to Claude Code if nothing detected
  if [ "$INSTALL_CLAUDE" -eq 0 ] && [ "$INSTALL_CODEX" -eq 0 ]; then
    INSTALL_CLAUDE=1
  fi
elif [ "$AGENT_HOST" = "claude" ]; then
  INSTALL_CLAUDE=1
elif [ "$AGENT_HOST" = "codex" ]; then
  INSTALL_CODEX=1
fi

REGISTERED=""

if [ "$INSTALL_CLAUDE" -eq 1 ]; then
  mkdir -p "$HOME/.claude/skills"
  ln -snf "$SOURCE_DIR" "$HOME/.claude/skills/unbrowse"
  REGISTERED="${REGISTERED}Claude Code, "
fi

if [ "$INSTALL_CODEX" -eq 1 ]; then
  mkdir -p "$HOME/.codex/skills"
  ln -snf "$SOURCE_DIR" "$HOME/.codex/skills/unbrowse"
  REGISTERED="${REGISTERED}Codex, "
fi

REGISTERED="${REGISTERED%, }"
[ -n "$REGISTERED" ] && ok "Registered with: $REGISTERED"

# ─── 4. Run the CLI's own setup (Kuri, server, marketplace) ──
info "Running unbrowse setup..."
if [ "$BUN_OK" -eq 1 ]; then
  exec bun "$SOURCE_DIR/src/cli.ts" setup $CLI_FLAGS
else
  exec npx tsx "$SOURCE_DIR/src/cli.ts" setup $CLI_FLAGS
fi

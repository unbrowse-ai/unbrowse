   return true;
 }
 
+// The two extensions Chrome sends that BoringSSL does not: 0x12e0 and
+// 0xca34. Their payloads are the browser's own, captured from a live
+// ClientHello. A door that judges the handshake reads these; without them the
+// client is challenged while the browser is not.
+//
+// Both are client-side only, and BoringSSL calls every extension's
+// parse_serverhello with a null buffer for whatever the server left out, so
+// the server-side handlers must exist and must accept the absent case. They
+// also accept an echo: these two carry nothing a client acts on, and a server
+// that mirrors extensions back should not fail the handshake over it.
+static bool chrome_ext_ignore_serverhello(SSL_HANDSHAKE *hs, uint8_t *out_alert,
+                                          CBS *contents) {
+  return true;
+}
+
+static bool chrome_ext_12e0_add_clienthello(const SSL_HANDSHAKE* hs, CBB* out,
+                                            CBB* out_compressible,
+                                            ssl_client_hello_type_t type) {
+  static const uint8_t kBody[] = {0x00, 0x00};
+  if (!CBB_add_u16(out, 0x12e0) || !CBB_add_u16(out, sizeof(kBody))) {
+    return false;
+  }
+  return CBB_add_bytes(out, kBody, sizeof(kBody));
+}

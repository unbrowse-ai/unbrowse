diff --git a/ssl/ssl_privkey.cc b/ssl/ssl_privkey.cc
--- a/ssl/ssl_privkey.cc
+++ b/ssl/ssl_privkey.cc
@@ -35,4 +35,4 @@
 bool ssl_is_key_type_supported(int key_type) {
-  return key_type == EVP_PKEY_RSA || key_type == EVP_PKEY_EC ||

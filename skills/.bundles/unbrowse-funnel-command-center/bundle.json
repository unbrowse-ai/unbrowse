{
  "bundle_id": "unbrowse-funnel-command-center",
  "title": "Unbrowse Funnel Command Center Bundle",
  "fabric": {
    "repo": "https://github.com/unbrowse-ai/foundry",
    "skill": "foundry"
  },
  "repo": "https://github.com/unbrowse-ai/unbrowse",
  "bootstrap_skill": "find-skills",
  "skills": [
    "unbrowse-funnel-command-center",
    "internal-analytics",
    "unbrowse-acquisition-operator",
    "x-campaign-feedback-operator"
  ],
  "routes": [
    {
      "when": "the request is about the entire funnel, biggest leak, or what to tighten next",
      "call": "unbrowse-funnel-command-center"
    },
    {
      "when": "the request is about private analytics truth or route contracts",
      "call": "internal-analytics"
    },
    {
      "when": "the request is about traffic, ICPs, variants, or landing leakage",
      "call": "unbrowse-acquisition-operator"
    },
    {
      "when": "the request is about X posts, articles, ads, and landing variants aligning under one feedback loop",
      "call": "x-campaign-feedback-operator"
    }
  ],
  "dependency_graph": {
    "nodes": [
      {
        "skill": "foundry",
        "provides": [
          "workflow-bundle-fabrication",
          "candidate-skill-discovery",
          "host-memory-routing"
        ],
        "requires": [
          "funnel-command-center"
        ],
        "alternatives": []
      },
      {
        "skill": "unbrowse-funnel-command-center",
        "provides": [
          "funnel-command-center",
          "full-funnel-triage"
        ],
        "requires": [
          "analytics-read",
          "acquisition-ops",
          "x-feedback-ops"
        ],
        "alternatives": [
          "unbrowse-funnel-operator"
        ]
      },
      {
        "skill": "internal-analytics",
        "provides": [
          "analytics-read"
        ],
        "requires": [],
        "alternatives": []
      },
      {
        "skill": "unbrowse-acquisition-operator",
        "provides": [
          "acquisition-ops"
        ],
        "requires": [],
        "alternatives": []
      },
      {
        "skill": "x-campaign-feedback-operator",
        "provides": [
          "x-feedback-ops"
        ],
        "requires": [],
        "alternatives": []
      }
    ]
  },
  "install_commands": {
    "foundry": "npx skills add https://github.com/unbrowse-ai/foundry --skill foundry --yes",
    "bundle_skills": [
      "npx skills add https://github.com/unbrowse-ai/unbrowse --skill unbrowse-funnel-command-center --yes",
      "npx skills add https://github.com/unbrowse-ai/unbrowse --skill internal-analytics --yes",
      "npx skills add https://github.com/unbrowse-ai/unbrowse --skill unbrowse-acquisition-operator --yes",
      "npx skills add https://github.com/unbrowse-ai/unbrowse --skill x-campaign-feedback-operator --yes"
    ]
  },
  "host_targets": [
    {
      "host": "codex",
      "target_path": "./AGENTS.md",
      "snippet_path": "hosts/codex/AGENTS.md"
    },
    {
      "host": "claude",
      "target_path": "./CLAUDE.md",
      "snippet_path": "hosts/claude/CLAUDE.md"
    },
    {
      "host": "openclaw",
      "target_path": "./MEMORY.md",
      "snippet_path": "hosts/openclaw/MEMORY.md"
    }
  ],
  "share": {
    "transport": "files",
    "manifest_path": "/.well-known/skill-bundles/unbrowse-funnel-command-center/share.json"
  },
  "index": {
    "slug": "unbrowse-funnel-command-center",
    "summary": "Route the full Unbrowse funnel from X and ads through landing, install, activation, retention, paid, and referral without collapsing all stages into one skill.",
    "tags": [
      "unbrowse",
      "funnel",
      "growth",
      "foundry",
      "operator"
    ]
  }
}

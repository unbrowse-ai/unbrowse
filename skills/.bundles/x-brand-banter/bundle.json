{
  "bundle_id": "x-brand-banter",
  "title": "X Brand Banter Bundle",
  "fabric": {
    "repo": "https://github.com/unbrowse-ai/foundry",
    "skill": "foundry"
  },
  "repo": "https://github.com/unbrowse-ai/unbrowse",
  "bootstrap_skill": "find-skills",
  "skills": [
    "x-brand-banter"
  ],
  "routes": [
    {
      "when": "the request is about making an X brand account funny, sharp, or personality-driven",
      "call": "x-brand-banter"
    },
    {
      "when": "the request is about Wendy's-, Ryanair-, MoonPie-, Steak-umm-, or mascot-style brand banter",
      "call": "x-brand-banter"
    },
    {
      "when": "the request is about roasty brand replies, quote tweets, or recurring account bits",
      "call": "x-brand-banter"
    }
  ],
  "dependency_graph": {
    "nodes": [
      {
        "skill": "foundry",
        "provides": [
          "workflow-bundle-fabrication",
          "candidate-skill-discovery",
          "host-memory-routing"
        ],
        "requires": [
          "x-brand-banter-ops"
        ],
        "alternatives": []
      },
      {
        "skill": "x-brand-banter",
        "provides": [
          "x-brand-banter-ops",
          "brand-account-personality-writing",
          "funny-in-character-x-replies"
        ],
        "requires": [],
        "alternatives": [
          "witty-humour-tweets",
          "x-virality"
        ]
      }
    ]
  },
  "install_commands": {
    "foundry": "npx skills add https://github.com/unbrowse-ai/foundry --skill foundry --yes",
    "bundle_skills": [
      "npx skills add https://github.com/unbrowse-ai/unbrowse --skill x-brand-banter --yes"
    ]
  },
  "host_targets": [
    {
      "host": "codex",
      "target_path": "./AGENTS.md",
      "snippet_path": "hosts/codex/AGENTS.md"
    },
    {
      "host": "claude",
      "target_path": "./CLAUDE.md",
      "snippet_path": "hosts/claude/CLAUDE.md"
    },
    {
      "host": "openclaw",
      "target_path": "./MEMORY.md",
      "snippet_path": "hosts/openclaw/MEMORY.md"
    }
  ],
  "share": {
    "transport": "files",
    "manifest_path": "/.well-known/skill-bundles/x-brand-banter/share.json"
  },
  "index": {
    "slug": "x-brand-banter",
    "summary": "Write funny, in-character X brand posts and replies that feel like remembered accounts instead of generic marketing.",
    "tags": [
      "x",
      "brand-voice",
      "humor",
      "banter",
      "foundry"
    ]
  }
